# Whitelist: somente os arquivos do projeto +Foco são versionados.
# O restante da pasta Downloads (fotos, PDFs, instaladores) fica de fora.
/*
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/capacitor.config.ts
!/src/
!/public/
!/android/
!/.github/
!/src/**
!/public/**
!/android/**
!/.github/**
node_modules/
dist/
*.log